{
  "name": "setup-node-api",
  "version": "1.1.3",
  "description": "CLI tool to scaffold Node.js + Express APIs instantly",
  "type": "commonjs",
  "main": "bin/cli.js",
  "bin": {
    "setup-node-api": "bin/cli.js"
  },
  "preferGlobal": true,
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "node bin/cli.js",
    "test": "node test/run-tests.js"
  },
  "keywords": [
    "cli",
    "nodejs",
    "express",
    "api",
    "scaffold",
    "boilerplate",
    "generator",
    "backend",
    "npx"
  ],
  "author": "codehassoul",
  "license": "MIT",
  "homepage": "https://github.com/codehassoul/setup-node-api#readme",
  "bugs": {
    "url": "https://github.com/codehassoul/setup-node-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codehassoul/setup-node-api.git"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.2"
  }
}
